+
+// ---------------------------------------------------------------------------
+// BL-111 prototype (B): a store that may change what Node's own loader
+// reads or writes on the builtin objects widens the whole closure.
+// ---------------------------------------------------------------------------
+
+const BL111_TIER: "A" | "B" | "Bliteral" = "B";
+
+/** Builtin members that define, set or re-parent a property of the object they are handed. */
+const BL111_STORING_CALLS: ReadonlySet<string> = new Set([
+  "defineProperty",
+  "defineProperties",
+  "setPrototypeOf",
+  "__defineGetter__",
+  "__defineSetter__",
+]);
+/** Builtin members that SET (run setters, store data) on the object they are handed. */
+const BL111_SETTING_CALLS: ReadonlySet<string> = new Set(["assign", "set"]);
+/** Names whose store re-parents an object or replaces its species. */
+const BL111_LOADER_NAMES: ReadonlySet<string> = new Set([
+  "__proto__",
+  "constructor",
+]);
+
+/** The object a call of a storing member writes onto: the first argument, or the receiver of `x.__defineGetter__`. */
+function bl111StoreTarget(
+  call: ts.CallExpression,
+  name: string,
+): ts.Expression | undefined {
+  if (name === "__defineGetter__" || name === "__defineSetter__") {
+    return ts.isPropertyAccessExpression(call.expression)
+      ? call.expression.expression
+      : undefined;
+  }
+  return call.arguments[0];
+}
+
+/**
+ * BL-111 prototype: whether the file may store, on an object not proven the
+ * program's own, something Node's loader reads or writes by inheritance.
+ */
+export function fileMayRedirectLoader(
+  context: LoaderClassificationContext,
+): boolean {
+  let found = false;
+  const visit = (node: ts.Node): void => {
+    if (found) {
+      return;
+    }
+    if (ts.isWithStatement(node)) {
+      found = true;
+      return;
+    }
+    if (BL111_TIER === "A") {
+      const callee =
+        ts.isCallExpression(node) || ts.isNewExpression(node)
+          ? memberAccessOf(node.expression)?.name
+          : undefined;
+      if (
+        invocationSiteOf(node)?.kind === "escaping_assignment" ||
+        (callee !== undefined &&
+          (BL111_STORING_CALLS.has(callee) || BL111_SETTING_CALLS.has(callee)))
+      ) {
+        found = true;
+        return;
+      }
+    } else {
+      if (ts.isCallExpression(node)) {
+        const name = memberAccessOf(node.expression)?.name;
+        const calls =
+          name !== undefined &&
+          (BL111_STORING_CALLS.has(name) ||
+            (BL111_TIER === "B" && BL111_SETTING_CALLS.has(name)));
+        const target = calls ? bl111StoreTarget(node, name!) : undefined;
+        if (target !== undefined && !isProvenFreshObject(target)) {
+          found = true;
+          return;
+        }
+      }
+      if (
+        ts.isBinaryExpression(node) &&
+        node.operatorToken.kind >= ts.SyntaxKind.FirstAssignment &&
+        node.operatorToken.kind <= ts.SyntaxKind.LastAssignment
+      ) {
+        const target = skipTransparentWrappers(node.left);
+        const member = memberAccessOf(target);
+        if (
+          member !== undefined &&
+          (member.name === undefined
+            ? BL111_TIER === "B"
+            : BL111_LOADER_NAMES.has(member.name)) &&
+          !isProvenFreshObject(member.receiver)
+        ) {
+          found = true;
+          return;
+        }
+      }
+    }
+    ts.forEachChild(node, visit);
+  };
+  visit(context.index.sourceFile);
+  return found;
+}
