+
+// ---------------------------------------------------------------------------
+// BL-122 prototype (R-S): a store onto a SPELLED builtin object outside the
+// ECMAScript intrinsic prototypes widens the whole closure. Unsound by
+// construction (a receiver reached any other way -- a parameter, a
+// container, a getter -- is not seen); it prices the visible part of the
+// class only.
+// ---------------------------------------------------------------------------
+
+/** Global constructors whose own properties a store may change (O1), and Node's own (O2). */
+const BL122_CONSTRUCTORS: ReadonlySet<string> = new Set([
+  "Object",
+  "Function",
+  "Array",
+  "Number",
+  "Boolean",
+  "String",
+  "Symbol",
+  "Date",
+  "Promise",
+  "RegExp",
+  "Error",
+  "ArrayBuffer",
+  "SharedArrayBuffer",
+  "DataView",
+  "Map",
+  "Set",
+  "WeakMap",
+  "WeakSet",
+  "BigInt",
+  "Int8Array",
+  "Uint8Array",
+  "Uint8ClampedArray",
+  "Int16Array",
+  "Uint16Array",
+  "Int32Array",
+  "Uint32Array",
+  "Float32Array",
+  "Float64Array",
+  "BigInt64Array",
+  "BigUint64Array",
+  "URL",
+  "URLSearchParams",
+  "Buffer",
+]);
+/** Node's own constructors whose `prototype` a store may change (O2). */
+const BL122_NODE_PROTOTYPES: ReadonlySet<string> = new Set([
+  "URL",
+  "URLSearchParams",
+  "Buffer",
+]);
+const BL122_STORING_CALLS: ReadonlySet<string> = new Set([
+  "defineProperty",
+  "defineProperties",
+  "setPrototypeOf",
+  "__defineGetter__",
+  "__defineSetter__",
+  "assign",
+  "set",
+]);
+
+function bl122IsBuiltinSpecifier(text: string): boolean {
+  return isBuiltin(text);
+}
+
+/** Whether `expr` is spelled as a builtin object outside the intrinsic prototypes. */
+function bl122IsSpelledBuiltinObject(
+  expr: ts.Expression,
+  builtinLocals: ReadonlySet<string>,
+): boolean {
+  const e = skipTransparentWrappers(expr);
+  if (ts.isIdentifier(e)) {
+    return BL122_CONSTRUCTORS.has(e.text) || builtinLocals.has(e.text);
+  }
+  if (
+    ts.isCallExpression(e) &&
+    ts.isIdentifier(e.expression) &&
+    e.expression.text === "require" &&
+    e.arguments.length === 1 &&
+    ts.isStringLiteralLike(e.arguments[0]!)
+  ) {
+    return bl122IsBuiltinSpecifier(e.arguments[0].text);
+  }
+  const member = memberAccessOf(e);
+  if (member !== undefined) {
+    const receiver = skipTransparentWrappers(member.receiver);
+    // `URL.prototype`, `require("events").prototype`, `path.posix`.
+    if (member.name === "prototype") {
+      return (
+        (ts.isIdentifier(receiver) &&
+          BL122_NODE_PROTOTYPES.has(receiver.text)) ||
+        (bl122IsSpelledBuiltinObject(receiver, builtinLocals) &&
+          !(
+            ts.isIdentifier(receiver) &&
+            BL122_CONSTRUCTORS.has(receiver.text) &&
+            !BL122_NODE_PROTOTYPES.has(receiver.text)
+          ))
+      );
+    }
+    if (member.name === "posix" || member.name === "win32") {
+      return bl122IsSpelledBuiltinObject(receiver, builtinLocals);
+    }
+  }
+  return false;
+}
+
+/**
+ * BL-122 prototype (R-S): whether the file may store onto a spelled builtin
+ * object outside the intrinsic prototypes -- a builtin module's exports
+ * object, a builtin constructor, or Node's own builtin prototype.
+ */
+export function fileMayRedirectLoader(
+  context: LoaderClassificationContext,
+): boolean {
+  const builtinLocals = new Set<string>();
+  for (const imp of context.model.imports) {
+    if (
+      imp.localName !== undefined &&
+      (imp.kind === "default" || imp.kind === "namespace") &&
+      bl122IsBuiltinSpecifier(imp.specifier)
+    ) {
+      builtinLocals.add(imp.localName);
+    }
+  }
+  let found = false;
+  const visit = (node: ts.Node): void => {
+    if (found) {
+      return;
+    }
+    if (ts.isCallExpression(node)) {
+      const name = memberAccessOf(node.expression)?.name;
+      if (name !== undefined && BL122_STORING_CALLS.has(name)) {
+        const target =
+          name === "__defineGetter__" || name === "__defineSetter__"
+            ? memberAccessOf(node.expression)?.receiver
+            : node.arguments[0];
+        if (
+          target !== undefined &&
+          bl122IsSpelledBuiltinObject(target, builtinLocals)
+        ) {
+          found = true;
+          return;
+        }
+      }
+    }
+    if (
+      ts.isBinaryExpression(node) &&
+      node.operatorToken.kind >= ts.SyntaxKind.FirstAssignment &&
+      node.operatorToken.kind <= ts.SyntaxKind.LastAssignment
+    ) {
+      const member = memberAccessOf(skipTransparentWrappers(node.left));
+      if (
+        member !== undefined &&
+        bl122IsSpelledBuiltinObject(member.receiver, builtinLocals)
+      ) {
+        found = true;
+        return;
+      }
+    }
+    ts.forEachChild(node, visit);
+  };
+  visit(context.index.sourceFile);
+  return found;
+}
