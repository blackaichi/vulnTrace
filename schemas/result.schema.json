{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulntrace.dev/schema/result-0.6.json",
  "type": "object",
  "required": ["schemaVersion", "scan", "findings", "coverage", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "object",
      "required": ["id", "project"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vulnerability", "package", "version", "verdict"],
        "properties": {
          "vulnerability": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": ["AFFECTED", "NOT_AFFECTED", "UNKNOWN"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "target": {
            "type": "object",
            "required": ["module", "symbol"],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "verdict": {
              "enum": ["AFFECTED", "NOT_AFFECTED"]
            }
          }
        },
        "then": {
          "properties": {
            "evidence": {
              "type": "object"
            }
          },
          "required": ["evidence"]
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "files",
        "modulesResolved",
        "modulesUnresolved",
        "functions",
        "callsResolved",
        "callsDynamic"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "modulesResolved": {
          "type": "integer",
          "minimum": 0
        },
        "modulesUnresolved": {
          "type": "integer",
          "minimum": 0
        },
        "functions": {
          "type": "integer",
          "minimum": 0
        },
        "callsResolved": {
          "type": "integer",
          "minimum": 0
        },
        "callsDynamic": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "message"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
