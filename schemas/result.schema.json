{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulntrace.dev/schema/result-0.6.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "scan",
    "findings",
    "coverage",
    "diagnostics",
    "timings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "object",
      "required": [
        "id",
        "project"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vulnerability",
          "package",
          "version",
          "verdict"
        ],
        "properties": {
          "vulnerability": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "AFFECTED",
              "NOT_AFFECTED",
              "UNKNOWN"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "target": {
            "type": "object",
            "required": [
              "module",
              "symbol"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confirmedAbsentFromModuleLoadClosure": {
                "type": "object",
                "description": "VT-307d module-load absence proof: positive evidence that this exact canonical installed package instance cannot be loaded from the configured entrypoint roots, under VulnTrace's declared supported module-loading model. Present only on a NOT_AFFECTED whose reasons include package_instance_not_in_complete_module_load_closure. This is module-load absence, NOT call-graph absence.",
                "required": [
                  "packageInstance",
                  "entrypointRoots",
                  "closureComplete"
                ],
                "properties": {
                  "packageInstance": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The exact canonical install LOCATION proved absent -- never a package name, version, or name+version pair."
                  },
                  "entrypointRoots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "The configured entrypoint files the absence proof is relative to. Non-empty by construction."
                  },
                  "closureComplete": {
                    "const": true,
                    "description": "Always true: closure completeness is the load-bearing precondition, recorded explicitly rather than left implicit."
                  }
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "verdict": {
              "enum": [
                "AFFECTED",
                "NOT_AFFECTED"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "evidence": {
              "type": "object"
            }
          },
          "required": [
            "evidence"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "files",
        "modulesResolved",
        "modulesUnresolved",
        "functions",
        "callsResolved",
        "callsDynamic"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "modulesResolved": {
          "type": "integer",
          "minimum": 0
        },
        "modulesUnresolved": {
          "type": "integer",
          "minimum": 0
        },
        "functions": {
          "type": "integer",
          "minimum": 0
        },
        "callsResolved": {
          "type": "integer",
          "minimum": 0
        },
        "callsDynamic": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "message"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timings": {
      "type": "object",
      "required": [
        "parsingMs",
        "resolutionMs",
        "graphConstructionMs",
        "reachabilityMs",
        "providerMs",
        "cacheHits",
        "cacheMisses",
        "totalMs"
      ],
      "properties": {
        "parsingMs": {
          "type": "number",
          "minimum": 0
        },
        "resolutionMs": {
          "type": "number",
          "minimum": 0
        },
        "graphConstructionMs": {
          "type": "number",
          "minimum": 0
        },
        "reachabilityMs": {
          "type": "number",
          "minimum": 0
        },
        "providerMs": {
          "type": "number",
          "minimum": 0
        },
        "cacheHits": {
          "type": "integer",
          "minimum": 0
        },
        "cacheMisses": {
          "type": "integer",
          "minimum": 0
        },
        "totalMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
