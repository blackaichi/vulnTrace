{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulntrace.dev/schema/result-0.6.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "scan",
    "findings",
    "coverage",
    "diagnostics",
    "timings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "object",
      "required": [
        "id",
        "project"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vulnerability",
          "package",
          "version",
          "verdict"
        ],
        "properties": {
          "vulnerability": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "AFFECTED",
              "NOT_AFFECTED",
              "UNKNOWN"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "target": {
            "type": "object",
            "required": [
              "module",
              "symbol"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confirmedAbsentFromModuleLoadClosure": {
                "type": "object",
                "description": "VT-307d module-load absence proof: positive evidence that this exact canonical installed package instance cannot be loaded from the configured entrypoint roots, under VulnTrace's declared supported module-loading model. Present only on a NOT_AFFECTED whose reasons include package_instance_not_in_complete_module_load_closure. This is module-load absence, NOT call-graph absence.",
                "required": [
                  "packageInstance",
                  "entrypointRoots",
                  "closureComplete"
                ],
                "properties": {
                  "packageInstance": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The exact canonical install LOCATION proved absent -- never a package name, version, or name+version pair."
                  },
                  "entrypointRoots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "The configured entrypoint files the absence proof is relative to. Non-empty by construction."
                  },
                  "closureComplete": {
                    "const": true,
                    "description": "Always true: closure completeness is the load-bearing precondition, recorded explicitly rather than left implicit."
                  }
                }
              },
              "confirmedAbsentInstance": {
                "type": "object",
                "description": "VT-307e proof family B (hardened by VT-307e's own final audit): positive evidence that this exact canonical installed package instance was never traversed by a non-truncated call graph, AND is independently corroborated absent from a complete, gate-eligible ModuleLoadClosure. Call-graph absence alone (graphTruncated=false) is NOT sufficient -- a package instance reached only through a re-export declaration is invisible to call-graph discovery while genuinely loaded and called, so the ModuleLoadClosure corroboration is the load-bearing half of this proof. Distinct from confirmedAbsentFromModuleLoadClosure, which is the stronger claim that the instance cannot be LOADED at all, established directly rather than by corroboration.",
                "required": [
                  "packageInstance",
                  "entrypointRoots",
                  "graphTruncated",
                  "moduleLoadClosureComplete"
                ],
                "properties": {
                  "packageInstance": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exact canonical install LOCATION -- never a name or version."
                  },
                  "entrypointRoots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "The configured entrypoint files this proof is relative to. Non-empty by construction."
                  },
                  "graphTruncated": {
                    "const": false,
                    "description": "Always false: a truncated call graph cannot support this proof (VT-202). Establishes only that the call graph's traversal did not hit a resource limit -- not that the call graph is complete."
                  },
                  "moduleLoadClosureComplete": {
                    "const": true,
                    "description": "Always true: the independent ModuleLoadClosure corroboration that makes this proof sound despite the call graph's own traversal not being import-complete (VT-307e)."
                  }
                }
              },
              "confirmedUnreachableTarget": {
                "type": "object",
                "description": "VT-307e proof family C: positive evidence that a resolved, attributed vulnerable target has no call path from any configured entrypoint, established by an exhaustive search that met no unresolved edge in the reachable subgraph. Says nothing about whether the package is present or loaded -- it may be both.",
                "required": [
                  "target",
                  "entrypointRoots",
                  "callGraphComplete"
                ],
                "properties": {
                  "target": {
                    "type": "object",
                    "required": [
                      "module",
                      "export"
                    ],
                    "properties": {
                      "module": {
                        "type": "string",
                        "minLength": 1
                      },
                      "export": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "entrypointRoots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "The configured entrypoint files this proof is relative to. Non-empty by construction."
                  },
                  "callGraphComplete": {
                    "const": true,
                    "description": "Always true: a truncated call graph cannot support this proof (VT-202)."
                  }
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "verdict": {
              "enum": [
                "AFFECTED",
                "NOT_AFFECTED"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "evidence": {
              "type": "object"
            }
          },
          "required": [
            "evidence"
          ]
        },
        "allOf": [
          {
            "description": "VT-CONTRACT-01 -- EXACTLY ONE negative proof on a NOT_AFFECTED. NOT_AFFECTED is a positive claim (see src/domain/evidence.ts's negative-proof contract), so a NOT_AFFECTED finding must carry precisely one of the three proof-family evidence objects: never zero (an unproven NOT_AFFECTED is exactly the false negative AGENTS.md forbids), and never two or more (the three families make materially different claims under different preconditions, so a finding asserting more than one is contradictory about what was actually established). oneOf expresses EXACTLY one rather than at least one: each branch requires a different proof object, so a finding carrying two matches two branches and is rejected. `required: [evidence]` is restated here, rather than inherited from the sibling if/then above, so this invariant cannot be silently weakened by a later edit to that rule.",
            "if": {
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {
                  "const": "NOT_AFFECTED"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "type": "object",
                  "oneOf": [
                    {
                      "title": "Family A -- module-load absence",
                      "type": "object",
                      "properties": {
                        "confirmedAbsentFromModuleLoadClosure": true
                      },
                      "required": [
                        "confirmedAbsentFromModuleLoadClosure"
                      ]
                    },
                    {
                      "title": "Family B -- exact-instance absence corroborated by call graph and module-load closure",
                      "type": "object",
                      "properties": {
                        "confirmedAbsentInstance": true
                      },
                      "required": [
                        "confirmedAbsentInstance"
                      ]
                    },
                    {
                      "title": "Family C -- confirmed unreachable target",
                      "type": "object",
                      "properties": {
                        "confirmedUnreachableTarget": true
                      },
                      "required": [
                        "confirmedUnreachableTarget"
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "description": "VT-CONTRACT-01 -- NO negative proof on any other verdict. The three proof objects justify NOT_AFFECTED and nothing else: an AFFECTED carrying one would assert a reachable path and its own absence simultaneously, and an UNKNOWN carrying one would present a completed proof for a verdict that exists precisely because no proof completed. Stated as three false subschemas rather than one `not`, so a violation reports the exact offending field. This is what stops stale proof evidence from surviving an accidental object reuse or a future refactor.",
            "if": {
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {
                  "enum": [
                    "AFFECTED",
                    "UNKNOWN"
                  ]
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "evidence": {
                  "type": "object",
                  "properties": {
                    "confirmedAbsentFromModuleLoadClosure": false,
                    "confirmedAbsentInstance": false,
                    "confirmedUnreachableTarget": false
                  }
                }
              }
            }
          }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "files",
        "modulesResolved",
        "modulesUnresolved",
        "functions",
        "callsResolved",
        "callsDynamic"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "modulesResolved": {
          "type": "integer",
          "minimum": 0
        },
        "modulesUnresolved": {
          "type": "integer",
          "minimum": 0
        },
        "functions": {
          "type": "integer",
          "minimum": 0
        },
        "callsResolved": {
          "type": "integer",
          "minimum": 0
        },
        "callsDynamic": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "message"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timings": {
      "type": "object",
      "required": [
        "parsingMs",
        "resolutionMs",
        "graphConstructionMs",
        "reachabilityMs",
        "providerMs",
        "cacheHits",
        "cacheMisses",
        "totalMs"
      ],
      "properties": {
        "parsingMs": {
          "type": "number",
          "minimum": 0
        },
        "resolutionMs": {
          "type": "number",
          "minimum": 0
        },
        "graphConstructionMs": {
          "type": "number",
          "minimum": 0
        },
        "reachabilityMs": {
          "type": "number",
          "minimum": 0
        },
        "providerMs": {
          "type": "number",
          "minimum": 0
        },
        "cacheHits": {
          "type": "integer",
          "minimum": 0
        },
        "cacheMisses": {
          "type": "integer",
          "minimum": 0
        },
        "totalMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
