{
  "name": "vulntrace",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript vulnerability-specific reachability and impact analysis engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackaichi/vulnTrace.git"
  },
  "bugs": {
    "url": "https://github.com/blackaichi/vulnTrace/issues"
  },
  "homepage": "https://github.com/blackaichi/vulnTrace#readme",
  "private": true,
  "type": "module",
  "bin": {
    "vulntrace": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage",
    "test:adversarial": "vitest run --config vitest.adversarial.config.ts",
    "test:validation": "vitest run --config vitest.validation.config.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "validate:history": "node scripts/validate-history.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "semver": "^7.8.5",
    "typescript": "^5.7.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
